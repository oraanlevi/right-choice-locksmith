{
  "permissions": {
    "allow": [
      "Bash(python3 maintenance/scripts/check_site.py:*)",
      "Bash(python3 maintenance/scripts/process_photos.py:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git reset:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git restore:*)",
      "Bash(git tag:*)",
      "Bash(vercel:*)",
      "Bash(npx vercel:*)",
      "Bash(gh:*)",
      "Edit(./.claude/settings.json)",
      "Write(./.claude/settings.json)",
      "Edit(./maintenance/hooks/**)",
      "Write(./maintenance/hooks/**)",
      "Edit(./.gitignore)",
      "Write(./.gitignore)",
      "Edit(./.vercelignore)",
      "Write(./.vercelignore)",
      "Edit(./vercel.json)",
      "Write(./vercel.json)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Edit(./.git/**)",
      "Write(./.git/**)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/maintenance/hooks/approval_gate.py\""
          }
        ]
      }
    ]
  }
}
